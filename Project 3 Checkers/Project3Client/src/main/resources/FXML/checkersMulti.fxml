<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" styleClass="root" xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="CheckersAPI">
   <BorderPane layoutX="2.0" layoutY="2.0" prefHeight="600.0" prefWidth="800.0" AnchorPane.bottomAnchor="10.0"
               AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
      <center>
         <VBox prefHeight="600.0" prefWidth="800.0" spacing="10.0" BorderPane.alignment="CENTER">
            <HBox prefHeight="470.0" prefWidth="780.0" spacing="10.0">
               <VBox prefHeight="470.0" prefWidth="180.0">
                  <Label styleClass="defaultLabel" text="Moves:"/>
                  <ListView fx:id="listMoves" prefHeight="217.6" prefWidth="180.0" styleClass="list-cell"/>
                  <Label styleClass="defaultLabel" text="Chat:"/>
                  <ListView fx:id="chatList" prefHeight="217.6" prefWidth="180.0" styleClass="list-cell"/>
               </VBox>
               <VBox prefHeight="470.0" prefWidth="400.0" spacing="5.0">
                  <Label fx:id="player2Name" styleClass="defaultLabel" text="Opponents Name"/>
                  <GridPane fx:id="board" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" VBox.vgrow="ALWAYS"/>
                  <Label fx:id="player1Name" styleClass="defaultLabel" text="Your Name"/>
               </VBox>
               <VBox prefHeight="470.0" prefWidth="180.0">
                  <Label styleClass="defaultLabel" text="Users Online:"/>
                  <ListView fx:id="listUsers" prefHeight="217.6" prefWidth="180.0" styleClass="list-cell"/>
                  <Label styleClass="defaultLabel" text="Online Friends:"/>
                  <ListView fx:id="listFriends" prefHeight="217.6" prefWidth="180.0" styleClass="list-cell"/>
               </VBox>
            </HBox>
            <HBox prefHeight="100.0" prefWidth="780.0">
               <VBox prefHeight="64.0" prefWidth="180.0" spacing="10.0">
                  <HBox minWidth="180.0" prefHeight="25.0" prefWidth="200.0" spacing="5.0">
                     <Button mnemonicParsing="false" onAction="#sendButtonHandler" styleClass="defaultButton" text="Send"/>
                     <TextField fx:id="sendField" prefHeight="25.0" prefWidth="133.0" styleClass="defaultTextField"/>
                  </HBox>
                  <Button fx:id="startGameBtn" mnemonicParsing="false" onAction="#handleRandomGame" prefHeight="25.0" prefWidth="185.0" styleClass="defaultButton" text="start random game"/>
               </VBox>
               <Region HBox.hgrow="ALWAYS"/>
               <VBox alignment="TOP_CENTER" prefHeight="64.0" prefWidth="360.0" spacing="10.0">
                  <Label fx:id="player1WinDrawLoss" styleClass="scoreLabel" text="Player1 scores" wrapText="true"/>
                  <Label fx:id="player2WinDrawLoss" styleClass="scoreLabel" text="Player2 scores" wrapText="true"/>
               </VBox>
               <Region HBox.hgrow="ALWAYS"/>
               <VBox minWidth="180.0" prefHeight="25.0" prefWidth="180.0" spacing="10.0">
                  <HBox prefHeight="25.0" prefWidth="200.0" spacing="5.0">
                     <Button mnemonicParsing="false" onAction="#friendBtnHandler" prefHeight="25.0" prefWidth="98.0" styleClass="defaultButton" text="Add Friend">
                        <HBox.margin>
                           <Insets/>
                        </HBox.margin>
                     </Button>
                     <TextField fx:id="friendField" maxWidth="100.0" prefHeight="25.0" prefWidth="107.0" styleClass="defaultTextField"/>
                  </HBox>
                  <HBox prefHeight="100.0" prefWidth="200.0" spacing="5.0">
                     <Button fx:id="drawBtn" mnemonicParsing="false" onAction="#drawBtnHandler" prefHeight="25.0" prefWidth="89.0" styleClass="defaultButton" text="request draw"/>
                     <Button fx:id="resignBtn" mnemonicParsing="false" onAction="#resignBtnHandler" prefHeight="25.0" prefWidth="92.0" styleClass="defaultButton" text="Resign"/>
                  </HBox>
               </VBox>
            </HBox>
            <HBox prefHeight="100.0" prefWidth="200.0"/>
         </VBox>
      </center>
   </BorderPane>
   <StackPane fx:id="winPopup" alignment="CENTER" pickOnBounds="true" style="-fx-background-color: rgba(0,0,0,0.6);"
              visible="false" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"
              AnchorPane.topAnchor="0">
      <VBox alignment="CENTER" maxHeight="400.0" maxWidth="300.0" spacing="20"
            style="-fx-background-color: bisque; -fx-padding: 30; -fx-background-radius: 10;">
         <Label fx:id="winMessage" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
         <Label fx:id="rematchRequest" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
         <HBox spacing="10.0">
            <Button fx:id="rematchBtn" onAction="#rematchBtnHandler" prefWidth="100.0" styleClass="defaultButton" text="rematch"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="quitBtn" onAction="#quitBtnHandler" prefWidth="100.0" styleClass="defaultButton" text="quit"/>
         </HBox>
      </VBox>
   </StackPane>
</AnchorPane>
