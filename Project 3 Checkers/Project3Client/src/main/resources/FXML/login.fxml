<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="CheckersAPI">
   <children>
      <BorderPane layoutY="-1.0" prefHeight="600.0" prefWidth="800.0" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
         <center>
            <VBox alignment="CENTER" prefHeight="380.0" prefWidth="580.0" spacing="10.0" BorderPane.alignment="CENTER">
               <children>
                  <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0">
                     <children>
                          <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
                             <children>
                                <Label text="Username: " />
                                <TextField fx:id="userfield" />
                             </children>
                          </HBox>
                           <Label fx:id="erroruser" text="Error: Username already taken." visible="false" />
                          <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
                             <children>
                                <Label text="Password: " />
                                <TextField fx:id = "passfield"/>
                             </children>
                          </HBox>
                           <Label disable="true" text="Error: Wrong Password for Username" />
                     </children>
                  </VBox>
                  <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="10.0">
                     <Button alignment="CENTER" mnemonicParsing="false" onAction="#handleStartGame" text="Play Game" />
<!--                      <RadioButton mnemonicParsing="false" selected="true" text="Singleplayer">-->
<!--                            <toggleGroup>-->
<!--                                <ToggleGroup fx:id="gameType" />-->
<!--                            </toggleGroup>/>-->
<!--                        </RadioButton>-->
<!--                        <RadioButton mnemonicParsing="false" text="Multiplayer" toggleGroup="$gameType" />-->
                  </HBox>
               </children>
            </VBox>
         </center>
      </BorderPane>
   </children>
</AnchorPane>
